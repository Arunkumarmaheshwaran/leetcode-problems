class Solution {
    public int differenceOfSum(int[] nums) {
     int sum=0;
     int count=0;
     for(int i=0;i<nums.length;i++) {
        sum+=nums[i];

        while(nums[i] > 0) {
            int res = nums[i]%10;
            count+=res;
            nums[i]/=10;
        }
     }   
           return (sum - count);
    }
}
