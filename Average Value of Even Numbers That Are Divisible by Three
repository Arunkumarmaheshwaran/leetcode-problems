class Solution {
    public int averageValue(int[] nums) {
        int n=0,a=0,b=0;
        n=nums.length;
        for(int i=0;i<n;i++){
            if(nums[i]%3==0 && nums[i]%2==0){
                a+=nums[i];
                b++;
               
            }
        } 


        if(b!=0)  return a/b;
        return 0;
    }
}
