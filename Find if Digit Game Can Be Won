class Solution {
    public boolean canAliceWin(int[] nums) {
     int s1=0,s2=0;
     int n=nums.length;
     for(int i=0;i<n;i++){
        if(nums[i]<10){
            s1+=nums[i];
        }
        else{
            s2+=nums[i];
        }
    }
    if(s1>s2) return true;
    if(s2>s1) return true;
    return false;
    }
}
